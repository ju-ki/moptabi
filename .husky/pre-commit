#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Running repository lint and format checks before commit..."

echo "-> Lint"
npm run lint
LINT_STATUS=$?
if [ $LINT_STATUS -ne 0 ]; then
  echo "Lint failed (status $LINT_STATUS). Commit aborted."
  exit $LINT_STATUS
fi

echo "-> Format check"
npm run format:check
FORMAT_STATUS=$?
if [ $FORMAT_STATUS -ne 0 ]; then
  echo "Format check failed (status $FORMAT_STATUS). Commit aborted."
  exit $FORMAT_STATUS
fi

echo "All lint and format checks passed. Proceeding with commit."
